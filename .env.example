# ─────────────────────────────────────────────────────────────
# Hydra environment variables — ALL PLANES
# Copy to .env and fill with real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── INTEL / HUNT PLANE ──────────────────────────────────────
# GMGN API key for official OpenAPI access. Hunt plane only.
# Upload your public key at gmgn.ai/ai to obtain this.
GMGN_API_KEY=REPLACE_ME_GMGN_API_KEY

# Agent-Reach optional API keys (if any provider requires one).
# Hunt plane only. Not required for doctor/setup.
AGENT_REACH_API_KEY=

# ── EXEC / SIGNING PLANE ─────────────────────────────────────
# Alchemy RPC key for Robinhood Chain (robinhood-mainnet.g.alchemy.com).
# Exec plane only. Used when public RPC is insufficient.
ALCHEMY_KEY=REPLACE_ME_ALCHEMY_KEY

# EVM hot wallet private key for exec plane. 0x-prefixed hex.
# NEVER put this in .env.hunt.example or the browser sidecar.
EVM_PRIVATE_KEY=0xYOUR_EVM_PRIVATE_KEY_HERE

# Solana hot wallet private key for exec plane. Base58 or JSON bytes.
# NEVER put this in .env.hunt.example or the browser sidecar.
SOLANA_PRIVATE_KEY=REPLACE_ME_SOLANA_PRIVATE_KEY

# ── RUNTIME ─────────────────────────────────────────────────
# Browser hunter sidecar base URL (TS -> Python bridge).
BROWSER_HUNTER_URL=http://localhost:8090

# Optional paid RPC URLs (exec plane only). Override public defaults.
RPC_BASE_HTTPS=
RPC_ROBINHOOD_HTTPS=
RPC_PULSE_HTTPS=
RPC_PULSE_WSS=
RPC_SOLANA_HTTPS=
